// ============================================================
// ToursBU — Core Application Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────

enum TripStatus {
  DRAFT
  REVIEW
  PUBLISHED
  BOOKINGS_CLOSED
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  ADVANCE_PAID
  PAYMENT_PENDING
  PARTIALLY_PAID
  FULLY_PAID
  CONFIRMED
  WAITLISTED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentAttemptStatus {
  CREATED
  ATTEMPTED
  SUCCESS
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  MANUAL
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
  DORMITORY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GovIdType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENSE
  OTHER
}

enum DietaryPreference {
  VEG
  NON_VEG
  JAIN
  VEGAN
  OTHER
}

enum EventType {
  BOOKING_STARTED
  BOOKING_CREATED
  BOOKING_LOCKED
  BOOKING_LOCK_EXPIRED
  TRAVELER_UPDATED
  PAYMENT_STARTED
  PAYMENT_FAILED
  PAYMENT_SUCCESS
  BOOKING_CONFIRMED
  CHECKLIST_CREATED
  RECEIPT_GENERATED
  WHATSAPP_READY
  LOCK_RELEASED
  EMAIL_SENT
  WHATSAPP_SHARED
  CHECKLIST_COMPLETED
  REFUND_STARTED
  REFUND_COMPLETED
  BOOKING_CANCELLED
  TRIP_COMPLETED
  WAITLIST_PROMOTED
  PAYMENT_LINK_SENT
  WAITLIST_EXPIRED
}

// ─── User ────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth Relations
  sessions Session[]
  accounts Account[]

  // ToursBU Custom Fields
  role                String  @default("STUDENT")
  phone               String?
  college             String?
  emergencyContact    String?
  onboardingCompleted Boolean @default(false)

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  couponUsages    CouponUsage[]
  bookingNotes    BookingNote[]
  bookingLocks    BookingLock[]
  notifications   Notification[]

  notificationPreference NotificationPreference?

  @@map("user")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String   @db.Text
  type      String   // e.g. PAYMENT, BOOKING, ALERT
  actionUrl String?
  read      Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification")
}

// ─── Better Auth Models ──────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Core Domain Models ──────────────────────────────────────

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  icon       String?
  coverImage String?
  featured   Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trips Trip[]

  @@map("category")
}

model Trip {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  shortDesc   String?
  description String?   @db.Text
  location    String?
  startDate   DateTime?
  endDate     DateTime?

  // Status & Visibility
  status     TripStatus @default(DRAFT)
  isArchived Boolean    @default(false)
  deletedAt  DateTime?

  // Relations
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Pricing & Capacity
  price         Int? // stored in cents or smallest currency unit
  advanceAmount Int?
  capacity      Int?

  // Analytics
  viewCount     Int @default(0)
  bookingClicks Int @default(0)
  favoriteCount Int @default(0)

  bookingStarted   Int @default(0)
  bookingCompleted Int @default(0)
  paymentSuccess   Int @default(0)
  paymentFailure   Int @default(0)
  couponApplied    Int @default(0)
  couponFailed     Int @default(0)

  // Document attachments
  brochureUrl String?

  // Standard timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  images        TripImage[]
  days          Day[]
  faqs          FAQ[]
  policies      CancellationPolicy[]
  reviews       Review[]
  bookings      Booking[]
  waitlist      WaitlistEntry[]
  rooms         Room[]
  buses         Bus[]
  coupons       Coupon[]
  whatsappGroup WhatsAppGroup?
  bookingLocks  BookingLock[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([startDate])
  @@map("trip")
}

model TripImage {
  id      String  @id @default(cuid())
  url     String
  isCover Boolean @default(false)
  order   Int     @default(0)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@map("trip_image")
}

model Day {
  id    String @id @default(cuid())
  title String
  order Int    @default(0)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@map("day")
}

model Activity {
  id          String  @id @default(cuid())
  title       String
  time        String?
  location    String?
  description String? @db.Text
  order       Int     @default(0)

  dayId String
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayId])
  @@map("activity")
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  order    Int    @default(0)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@map("faq")
}

model CancellationPolicy {
  id          String  @id @default(cuid())
  title       String?
  description String  @db.Text
  order       Int     @default(0)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@map("cancellation_policy")
}

model Review {
  id      String  @id @default(cuid())
  rating  Int
  comment String? @db.Text

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@map("review")
}

// ─── Booking & Payments ──────────────────────────────────────

model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status BookingStatus @default(DRAFT)

  totalAmount   Int
  advanceAmount Int
  amountPaid    Int @default(0)

  travelerCount Int

  expiresAt DateTime?

  isArchived Boolean   @default(false)
  whatsappJoined Boolean @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  travelers         BookingTraveler[]
  emergencyContacts EmergencyContact[]
  payments          Payment[]
  paymentAttempts   PaymentAttempt[]
  events            BookingEvent[]
  invoices          Invoice[]
  receipts          Receipt[]
  notes             BookingNote[]
  refunds           Refund[]
  couponUsages      CouponUsage[]
  checklistItems    BookingChecklistItem[]
  RoomAllocation    RoomAllocation[]
  BusAllocation     BusAllocation[]

  @@index([tripId])
  @@index([userId])
  @@index([bookingNumber])
  @@map("booking")
}

model BookingTraveler {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name               String
  email              String?
  phone              String?
  gender             Gender?
  dateOfBirth        DateTime?
  governmentIdType   GovIdType?
  governmentIdNumber String?
  dietaryPreference  DietaryPreference?

  isPrimary   Boolean @default(false)
  medicalInfo String? @db.Text

  documents   TravelerDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomAllocation RoomAllocation?
  busAllocation  BusAllocation?

  @@index([bookingId])
  @@map("booking_traveler")
}

model EmergencyContact {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name     String
  relation String
  phone    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("emergency_contact")
}

model BookingEvent {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId   String?

  eventType EventType
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_event")
}

model WaitlistEntry {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  travelerCount Int
  status        WaitlistStatus @default(WAITING)
  priority      Int            @default(0)
  promotedAt    DateTime?
  expiresAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([userId])
  @@map("waitlist_entry")
}

model PaymentAttempt {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  razorpayOrderId String               @unique
  amount          Int
  status          PaymentAttemptStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("payment_attempt")
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount        Int
  status        PaymentStatus @default(SUCCESS)
  type          String // ADVANCE, REMAINING, FULL
  method        PaymentMethod @default(RAZORPAY)
  transactionId String?       @unique // Razorpay payment ID
  receiptUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("payment")
}

model PaymentWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // From Razorpay
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("payment_webhook_event")
}

model Refund {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount           Int
  status           RefundStatus @default(PENDING)
  razorpayRefundId String?      @unique
  reason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("refund")
}

// ─── Allocations & Operations ────────────────────────────────

model Room {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  roomNumber String
  capacity   Int
  type       RoomType

  allocations RoomAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room")
}

model RoomAllocation {
  id         String          @id @default(cuid())
  bookingId  String
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId String          @unique
  traveler   BookingTraveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room_allocation")
}

model Bus {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  busNumber String
  capacity  Int

  allocations BusAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bus")
}

model BusAllocation {
  id         String          @id @default(cuid())
  bookingId  String
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId String          @unique
  traveler   BookingTraveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  busId String?
  bus   Bus?    @relation(fields: [busId], references: [id])

  seatNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bus_allocation")
}

model WhatsAppGroup {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  inviteLink String
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_group")
}

model BookingNote {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  user      User    @relation(fields: [authorId], references: [id])

  note       String  @db.Text
  isInternal Boolean @default(true) // If true, only admins see it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("booking_note")
}

// ─── Billing & Discounts ─────────────────────────────────────

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime?
  validUntil    DateTime?

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id])

  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupon")
}

model CouponUsage {
  id        String  @id @default(cuid())
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id])
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("coupon_usage")
}

model Invoice {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  invoiceNumber    String  @unique
  amount           Int
  gst              Int?
  organizationName String?
  paymentReference String?
  downloadCount    Int     @default(0)
  pdfUrl           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("invoice")
}

model Receipt {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  receiptNumber    String  @unique
  amount           Int
  gst              Int?
  organizationName String?
  paymentReference String?
  qrCodeReference  String?
  downloadCount    Int     @default(0)
  pdfUrl           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("receipt")
}

// ─── Email Logistics ─────────────────────────────────────────

model EmailLog {
  id         String  @id @default(cuid())
  to         String
  subject    String
  status     String  @default("SENT") // SENT, DELIVERED, FAILED, BOUNCED
  providerId String? // Resend ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_log")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailBooking    Boolean @default(true)
  emailReminder   Boolean @default(true)
  whatsappUpdates Boolean @default(true)
  marketing       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preference")
}

model AuditLog {
  id         String  @id @default(cuid())
  action     String
  actorId    String?
  resource   String
  resourceId String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@map("audit_log")
}

model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  enabled     Boolean @default(false)
  description String?

  updatedAt DateTime @updatedAt

  @@map("feature_flag")
}

model BookingLock {
  id            String @id @default(cuid())
  tripId        String
  trip          Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelerCount Int

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([userId])
  @@map("booking_lock")
}

model BookingChecklistItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  required    Boolean   @default(true)
  order       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("booking_checklist_item")
}

enum DocumentType {
  AADHAAR
  PASSPORT
  COLLEGE_ID
  CONSENT_FORM
  OTHER
}

model TravelerDocument {
  id          String   @id @default(cuid())

  travelerId  String
  traveler    BookingTraveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  type        DocumentType
  fileName    String
  storagePath String
  mimeType    String
  size        Int

  verified    Boolean  @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?

  createdAt   DateTime @default(now())
}

// ─── Admin Authentication ────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  CONTENT_ADMIN
  SUPPORT_ADMIN
  ADMIN
}

model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          AdminRole @default(ADMIN)
  isActive      Boolean   @default(true)

  mustChangePassword Boolean @default(false)

  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]

  @@map("admin")
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([token])
  @@map("admin_session")
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("admin_login_attempt")
}
