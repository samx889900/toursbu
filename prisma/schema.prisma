// ============================================================
// ToursBU — Complete Normalized Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization ────────────────────────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  logo         String   @default("")
  website      String   @default("")
  supportEmail String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]
  users User[]

  @@map("organizations")
}

// ─── User ────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ORGANIZER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  phone          String   @default("")
  avatar         String   @default("")
  role           UserRole @default(STUDENT)
  college        String   @default("")
  gender         Gender   @default(PREFER_NOT_TO_SAY)
  age            Int?
  emergencyContact String @default("")
  emergencyPhone   String @default("")
  organizationId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])
  bookings      Booking[]
  reviews       Review[]
  waitlists     Waitlist[]
  notifications Notification[]
  createdTrips  Trip[]         @relation("TripCreator")
  activityLogs  ActivityLog[]
  media         Media[]

  @@map("users")
}

// ─── Category ────────────────────────────────────────────────

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique
  icon String @default("")

  trips Trip[]

  @@map("categories")
}

// ─── Trip ────────────────────────────────────────────────────

enum TripStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}

model Trip {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  description      String     @db.Text
  location         String
  price            Float
  advanceAmount    Float
  totalSeats       Int
  availableSeats   Int
  tripStatus       TripStatus @default(DRAFT)
  difficulty       Difficulty @default(MODERATE)
  duration         String
  pickupPoint      String     @default("")
  startDate        DateTime
  endDate          DateTime
  whatsappLink     String     @default("")
  brochureUrl      String     @default("")
  coverImage       String     @default("")
  accommodation    String     @default("")
  travelDetails    String     @default("") @db.Text
  terms            Json       @default("[]")
  cancellationPolicy Json     @default("[]")
  categoryId       String?
  organizationId   String?
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  category      Category?     @relation(fields: [categoryId], references: [id])
  organization  Organization? @relation(fields: [organizationId], references: [id])
  createdBy     User?         @relation("TripCreator", fields: [createdById], references: [id])
  images        TripImage[]
  features      TripFeature[]
  days          Day[]
  faqs          TripFaq[]
  bookings      Booking[]
  reviews       Review[]
  waitlists     Waitlist[]

  @@map("trips")
}

// ─── Trip Image ──────────────────────────────────────────────

model TripImage {
  id      String @id @default(cuid())
  tripId  String
  mediaId String?
  url     String
  alt     String @default("")
  order   Int    @default(0)

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id])

  @@map("trip_images")
}

// ─── Trip Feature (Included/Excluded) ────────────────────────

enum FeatureType {
  INCLUDED
  EXCLUDED
}

model TripFeature {
  id     String      @id @default(cuid())
  tripId String
  type   FeatureType
  label  String
  icon   String      @default("")
  order  Int         @default(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_features")
}

// ─── Day & Activity (Itinerary) ──────────────────────────────

model Day {
  id          String @id @default(cuid())
  tripId      String
  dayNumber   Int
  title       String
  description String @default("")

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("days")
}

enum ActivityType {
  TRAVEL
  ACTIVITY
  MEAL
  STAY
  FREE
}

model Activity {
  id          String       @id @default(cuid())
  dayId       String
  title       String
  description String       @default("")
  time        String       @default("")
  location    String       @default("")
  type        ActivityType @default(ACTIVITY)
  order       Int          @default(0)

  day Day @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// ─── Trip FAQ ────────────────────────────────────────────────

model TripFaq {
  id       String @id @default(cuid())
  tripId   String
  question String
  answer   String @db.Text
  order    Int    @default(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_faqs")
}

// ─── Booking ─────────────────────────────────────────────────

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  CONFIRMED
  WAITLISTED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REFUNDED
}

model Booking {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  tripId          String
  userId          String
  status          BookingStatus @default(PENDING_PAYMENT)
  amountPaid      Float         @default(0)
  remainingAmount Float         @default(0)
  whatsappJoined  Boolean       @default(false)
  checkedIn       Boolean       @default(false)
  specialRequests String        @default("")
  roomAllocation  String        @default("")
  busAllocation   String        @default("")
  notes           String        @default("") @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  payments Payment[]

  @@map("bookings")
}

// ─── Payment ─────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  OFFLINE
  BANK_TRANSFER
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  BANK_TRANSFER
  OFFLINE
}

model Payment {
  id               String         @id @default(cuid())
  bookingId        String
  gateway          PaymentGateway @default(RAZORPAY)
  gatewayOrderId   String         @default("")
  gatewayPaymentId String         @default("")
  status           PaymentStatus  @default(PENDING)
  paymentMethod    PaymentMethod  @default(UPI)
  amount           Float
  currency         String         @default("INR")
  receiptUrl       String         @default("")
  paidAt           DateTime?
  createdAt        DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

// ─── Review ──────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  rating    Int
  review    String   @db.Text
  images    Json     @default("[]")
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ─── Coupon ──────────────────────────────────────────────────

enum CouponType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  discount  Float
  type      CouponType
  maxUses   Int        @default(0)
  usedCount Int        @default(0)
  expiresAt DateTime?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@map("coupons")
}

// ─── Waitlist ────────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  EXPIRED
}

model Waitlist {
  id        String         @id @default(cuid())
  tripId    String
  userId    String
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
  @@map("waitlists")
}

// ─── Notification ────────────────────────────────────────────

enum NotificationType {
  BOOKING
  PAYMENT
  TRIP
  SYSTEM
  PROMOTION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─── Email Queue ─────────────────────────────────────────────

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model EmailQueue {
  id        String      @id @default(cuid())
  recipient String
  subject   String
  template  String
  data      Json        @default("{}")
  status    EmailStatus @default(QUEUED)
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@map("email_queue")
}

// ─── Activity Log ────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String   @default("")
  ipAddress String   @default("")
  timestamp DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@map("activity_logs")
}

// ─── Media Library ───────────────────────────────────────────

enum MediaType {
  IMAGE
  PDF
  VIDEO
}

model Media {
  id         String    @id @default(cuid())
  url        String
  provider   String    @default("LOCAL")
  type       MediaType @default(IMAGE)
  size       Int       @default(0)
  uploadedBy String?
  createdAt  DateTime  @default(now())

  uploader   User?       @relation(fields: [uploadedBy], references: [id])
  tripImages TripImage[]

  @@map("media")
}

// ─── Content Block (Generic CMS) ─────────────────────────────

enum ContentBlockStatus {
  DRAFT
  PUBLISHED
}

model ContentBlock {
  id        String             @id @default(cuid())
  type      String
  slug      String             @unique
  title     String
  content   Json               @default("{}")
  status    ContentBlockStatus @default(DRAFT)
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("content_blocks")
}

// ─── Settings ────────────────────────────────────────────────

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String   @default("")
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
